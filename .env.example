# ════════════════════════════════════════════════════════════
# MTG 签绘管家 — 环境变量配置示例
# ════════════════════════════════════════════════════════════
#
# 使用方法：
#   1. 复制本文件为 .env.local（本地开发）或在部署平台配置对应变量
#   2. 将下方占位符替换为真实值
#   3. 切勿将真实密钥提交到 Git 仓库
#
# 标注说明：
#   [必需]      缺失时应用无法启动或核心功能不可用
#   [推荐]      生产环境强烈建议配置
#   [可选]      未配置时功能降级但不报错
# ════════════════════════════════════════════════════════════


# ─── Supabase 数据库 ──────────────────────────────────────
# 创建项目：https://supabase.com/dashboard
# 在 Project Settings → API 中获取以下值

# Supabase 项目 URL（如 https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key（服务端专用，绕过 RLS，拥有全部权限）
# ⚠️ 绝对不能暴露到前端代码中
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Anon Key（前端公开 Key，受 RLS 策略限制）
# 前端客户端初始化使用此 Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ─── 认证与安全 ──────────────────────────────────────────

# JWT Token 签名密钥（用于用户登录态签发与验证）
# 生产环境必须配置：建议 32+ 字符的随机字符串
# 生成方式：openssl rand -base64 32
# 未配置时开发环境使用默认值，生产环境启动会报错
TOKEN_SECRET=your-random-secret-at-least-32-chars-long

# 管理员用户名列表（逗号分隔，不区分大小写）
# 列在此处的用户登录后可访问 /admin 后台
# 示例：admin,zhangsan,lisi
ADMIN_USERS=admin


# ─── LLM 画师名单解析（parse-artists API）─────────────────
# 解析活动原文中的画家名单，支持两个服务商
# 至少配置其中一个，否则该功能不可用

# DeepSeek API Key（优先使用）
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# Anthropic API Key（DeepSeek 不可用时备选）
# 申请：https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
